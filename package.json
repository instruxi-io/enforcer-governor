{
  "name": "enforcer-governor",
  "version": "0.29.2",
  "description": "Enforcer Governor (GVNR): stops AI agents overspending and running dangerous commands, before the action runs. Per-minute spend caps, allow/deny/ask on every action, hash-chained receipts, MCP server. Free, self-hosted.",
  "type": "module",
  "bin": {
    "enforcer-governor": "src/cli.mjs"
  },
  "scripts": {
    "start": "node src/governor.mjs",
    "install-hook": "node src/cli.mjs install-hook",
    "test": "node test/policy.test.mjs && node test/receipts.test.mjs && node test/mcp.test.mjs"
  },
  "files": [
    "src",
    "public",
    "README.md",
    "LICENSE",
    "TRADEMARKS.md"
  ],
